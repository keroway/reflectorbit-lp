{
  "name": "reflectorbit-lp",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@12.11.1+sha512.5b0e3288239a7ea4155d2094f547066e122a1376b3cd785a680c9112e116913e64aaaecf20dd83cc34030fa67013f5c5511f9cf430dd8384188b4c60b8a2ad1e",
  "homepage": "https://reflectorbit-lp.pages.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keroway/reflectorbit-lp.git"
  },
  "bugs": {
    "url": "https://github.com/keroway/reflectorbit-lp/issues"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "typecheck": "astro check",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "biome check . && prettier --check \"**/*.md\"",
    "format": "biome format --write . && prettier --write \"**/*.md\"",
    "format:biome": "biome format --write .",
    "format:prettier": "prettier --write \"**/*.md\"",
    "og:gen": "node scripts/gen-og.mjs",
    "video:howtoplay:gen": "node scripts/gen-how-to-play-video.mjs",
    "check:video-colors": "node scripts/check-video-colors.mjs",
    "test:video-colors": "node --test scripts/check-video-colors.test.mjs",
    "check:headers": "node scripts/check-headers.mjs",
    "test:headers": "node --test scripts/check-headers.test.mjs",
    "asset:verify": "node scripts/asset-manifest.mjs verify",
    "test:asset-manifest": "node --test scripts/asset-manifest.test.mjs",
    "test": "playwright test",
    "smoke": "playwright test tests/smoke.test.ts",
    "smoke:a11y": "playwright test tests/a11y.test.ts",
    "postinstall": "lefthook install || true"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.8",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "^2.5.5",
    "@playwright/test": "^1.61.1",
    "hyperframes": "0.8.143",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3"
  }
}
