---
import { controls } from '../consts';
---

{/* ===== How to Play ===== */}
<section id="how-to-play" class="reveal scroll-mt-20 border-t border-white/5 py-24">
  <p class="eyebrow">How to Play</p>
  <h2 class="mt-3 text-3xl font-bold text-white sm:text-4xl">←/→ で回転、Space/Shift で軌道半径——3 キー操作</h2>
  <div class="mt-8 overflow-hidden rounded-lg border border-white/10">
    <table class="w-full text-left">
      <tbody>
        {
          controls.map((c) => (
            <tr class="border-b border-white/5 last:border-0">
              <th class="w-40 bg-white/5 px-5 py-4 font-mono text-rb-core">{c.key}</th>
              <td class="px-5 py-4">{c.desc}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <p class="mt-4 text-sm text-rb-muted/70">
    軌道半径を能動的に変えて、Meteor の落下タイミングと Shield の位置を合わせる。
    内周に寄るほどリスクが高まる代わりにスコア倍率が上がり、外周は安定してコンボを繋ぎやすい。
    Web 版はタッチ / ポインタ操作にも対応。
  </p>
  <ul class="mt-4 grid gap-3 text-sm text-rb-muted/80 sm:grid-cols-2">
    <li class="rounded-lg border border-white/5 p-4">
      <span class="font-semibold text-rb-shield">タップ / ホールド</span> — Space / Shift の短タップで ±48px ダッシュ、長押しで半径を徐々に変化。瞬間合わせと軌道調整を使い分ける。
    </li>
    <li class="rounded-lg border border-white/5 p-4">
      <span class="font-semibold text-rb-combo">アップグレードカード</span> — 偶数ステージクリア時に 3 択（ラン最大 5 枚）。射程・PERFECT 猶予・コンボ持続などを強化。
    </li>
  </ul>

  {/* Space=縮小 / Shift=拡大 の対比を示す動く図解（HyperFrames 生成） */}
  <figure class="mt-10">
    <div id="how-to-play-frame" class="relative aspect-video w-full overflow-hidden rounded-lg border border-white/10">
      <video
        class="how-to-play-video h-full w-full object-cover"
        muted
        loop
        playsinline
        controls
        poster="/videos/how-to-play-poster.jpg"
        aria-label="SPACE キーで軌道半径を縮小、SHIFT キーで軌道半径を拡大する図解動画"
      >
        <source src="/videos/how-to-play.webm" type="video/webm" />
        <source src="/videos/how-to-play.mp4" type="video/mp4" />
      </video>

      {/* 再生失敗時のみ表示: play() reject / video error イベントで切り替える。poster は背後に維持する */}
      <div
        id="how-to-play-error"
        hidden
        class="absolute inset-0 z-10 flex h-full w-full flex-col items-center justify-center gap-3 bg-rb-bg/80 px-6 text-center text-rb-muted"
      >
        <p class="text-sm font-semibold text-white">図解動画の再生に失敗しました</p>
        <div class="flex gap-4 text-sm">
          <button
            type="button"
            id="how-to-play-retry"
            class="rounded-sm text-rb-core underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rb-core"
          >
            再試行
          </button>
          <a
            class="rounded-sm text-rb-core underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rb-core"
            href="#how-to-play">上の操作表を見る</a
          >
        </div>
      </div>
    </div>
    <figcaption class="mt-3 text-center text-sm text-rb-muted/70">
      Space / Shift で軌道半径を変え、Meteor のタイミングを合わせる。
    </figcaption>
  </figure>
</section>

<script>
  /*
   * How to Play の動く図解 (<video>) を prefers-reduced-motion に応じて制御する。
   * 通常時は autoplay + loop で即時ロード・再生する（controls は常設し、ユーザーがいつでも
   * 一時停止できるようにする＝WCAG 2.2.2 Pause, Stop, Hide 対応）。
   * reduced-motion 時は autoplay を行わず、controls を出して静止画 (poster) のみ表示し
   * ユーザーが望めば手動再生できるようにする（Hero.astro の pauseAnimations() 分岐と同様の考え方）。
   */
  const howToPlayVideo = document.querySelector<HTMLVideoElement>('.how-to-play-video');
  const errorPanel = document.getElementById('how-to-play-error');
  const retry = document.getElementById('how-to-play-retry');

  if (howToPlayVideo && errorPanel && retry) {
    const mq = window.matchMedia('(prefers-reduced-motion: reduce)');

    // 失敗状態を表示する。poster は <video> ごと背後に残し、上に失敗パネルを重ねる。
    const showError = () => {
      errorPanel.hidden = false;
    };

    const retryPlayback = () => {
      errorPanel.hidden = true;
      void howToPlayVideo!.play().catch(showError);
    };

    // メディア読み込み自体の失敗（ソース欠落・デコード不可等）を利用者に伝える。
    howToPlayVideo.addEventListener('error', showError);
    retry.addEventListener('click', retryPlayback);

    function applyMotionPreference(reduced: boolean) {
      if (reduced) {
        howToPlayVideo!.removeAttribute('autoplay');
        howToPlayVideo!.removeAttribute('loop');
        howToPlayVideo!.setAttribute('controls', '');
        howToPlayVideo!.pause();
      } else {
        howToPlayVideo!.setAttribute('autoplay', '');
        howToPlayVideo!.setAttribute('loop', '');
        void howToPlayVideo!.play().catch(showError);
      }
    }

    applyMotionPreference(mq.matches);

    mq.addEventListener('change', (e) => applyMotionPreference(e.matches));
  }
</script>
