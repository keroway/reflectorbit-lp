---
import { PLAY_URL } from '../consts';
---

{/* ===== Playable Demo ===== */}
<section id="demo" class="reveal scroll-mt-20 border-t border-white/5 py-24">
  <p class="eyebrow">Playable Demo</p>
  <h2 class="mt-3 text-3xl font-bold text-white sm:text-4xl">その場で試遊</h2>
  <p class="mt-4 max-w-2xl text-rb-muted/80">
    ブラウザ版をその場で起動。読み込みは「起動」を押したときだけ走るので、モバイルや低速回線でも軽い。
  </p>

  {/* aspect-video 枠を常に確保しレイアウトシフトを防ぐ */}
  <div
    id="demo-frame"
    class="relative mt-8 aspect-video w-full overflow-hidden rounded-lg border border-white/15"
    data-play-url={PLAY_URL}
  >
    {/* 起動前ファサード: クリックで初めて iframe を遅延ロードする */}
    <button
      type="button"
      id="demo-launch"
      class="group absolute inset-0 flex h-full w-full flex-col items-center justify-center gap-3 bg-rb-bg/60 text-rb-muted transition hover:bg-rb-bg/40 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-rb-core"
    >
      <span class="font-mono text-5xl text-rb-core transition group-hover:scale-110">&#9654;</span>
      <span class="text-lg font-semibold">クリックして試遊を起動</span>
      <span class="text-sm text-rb-muted/60">←/→ で回転、Space/Shift で半径 / Web 版はタッチも対応</span>
    </button>

    {/* 読み込み中プレースホルダ: 起動後 iframe の load まで表示 */}
    <div
      id="demo-loading"
      hidden
      class="absolute inset-0 z-10 flex items-center justify-center bg-rb-bg/70 text-rb-muted/70"
    >
      読み込み中…
    </div>

    {/* 読み込み失敗時のみ表示: iframe の error イベントで切り替える */}
    <div
      id="demo-error"
      hidden
      class="absolute inset-0 z-10 flex h-full w-full flex-col items-center justify-center gap-3 bg-rb-bg/80 px-6 text-center text-rb-muted"
    >
      <p class="text-sm font-semibold text-white">試遊の読み込みに失敗しました</p>
      <div class="flex gap-4 text-sm">
        <button
          type="button"
          id="demo-retry"
          class="rounded-sm text-rb-core underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rb-core"
        >
          再試行
        </button>
        <a
          class="rounded-sm text-rb-core underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rb-core"
          href={PLAY_URL}
          target="_blank"
          rel="noopener">別タブで開く</a
        >
      </div>
    </div>
  </div>

  {/* 常設フォールバック: 埋め込みが動かない環境でもプレイページへ到達できる */}
  <p class="mt-4 text-sm text-rb-muted/70">
    うまく動かない場合は
    <a
      class="rounded-sm text-rb-core underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rb-core"
      href={PLAY_URL}
      target="_blank"
      rel="noopener">ブラウザ版を別タブで開く</a>。
  </p>
</section>

<script>
  const frame = document.getElementById('demo-frame');
  const launch = document.getElementById('demo-launch');
  const loading = document.getElementById('demo-loading');
  const errorPanel = document.getElementById('demo-error');
  const retry = document.getElementById('demo-retry');
  const playUrl = frame?.dataset.playUrl;

  if (frame && launch && loading && errorPanel && retry && playUrl) {
    const startLaunch = () => {
      launch.hidden = true;
      errorPanel.hidden = true;
      loading.hidden = false;
      loading.textContent = '読み込み中…';

      const iframe = document.createElement('iframe');
      iframe.src = playUrl;
      iframe.title = 'REFLECTORBIT ブラウザ版 試遊';
      iframe.className = 'absolute inset-0 z-0 h-full w-full border-0';
      iframe.allow = 'autoplay; fullscreen; gamepad; accelerometer';

      // load 完了でプレースホルダを消す。応答が遅い場合はフォールバック導線を出す。
      let settled = false;
      const fallbackTimer = window.setTimeout(() => {
        if (settled) return;
        settled = true;
        loading.innerHTML =
          '読み込みに時間がかかっています。<a class="text-rb-core underline" href="' +
          playUrl +
          '" target="_blank" rel="noopener">別タブで開く</a>';
      }, 8000);

      const showError = () => {
        if (settled) {
          // フォールバック導線表示後の error は無視し、既存の導線を維持する。
          return;
        }
        settled = true;
        window.clearTimeout(fallbackTimer);
        iframe.remove();
        loading.hidden = true;
        launch.hidden = true;
        errorPanel.hidden = false;
      };

      iframe.addEventListener('load', () => {
        settled = true;
        window.clearTimeout(fallbackTimer);
        loading.hidden = true;
      });

      // ネットワーク到達不能等で iframe 自体がエラーになった場合を検出する。
      // 注意: X-Frame-Options / CSP frame-ancestors によるブロックは実ブラウザでは
      // error ではなく load を発火するため、このリスナーでは検出できない（issue #219 で実測済み。
      // 詳細は docs/development.md の「PlayableDemo の iframe 読み込み失敗検出について」を参照）。
      // そのケースは下の fallbackTimer と常設フォールバックリンクで到達可能性を担保する。
      iframe.addEventListener('error', showError);

      frame.appendChild(iframe);
    };

    launch.addEventListener('click', startLaunch);
    retry.addEventListener('click', startLaunch);
  }
</script>
